# ---------------------------------------------------------------------------
# Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

# --- Model / serving ------------------------------------------------------
# Base model to compress. Swap for Qwen/Qwen3-8B if you want wider multilingual
# coverage; the rest of the pipeline is model-agnostic.
BASE_MODEL_ID=Qwen/Qwen2.5-7B-Instruct
SERVED_MODEL_NAME=qwen-support

# Where the compressed weights live inside the serving container.
MODEL_PATH=/models/qwen2.5-7b-instruct-w4a16

# Point this at your GPU box. Use http://vllm:8000/v1 when running the full
# compose stack locally, or http://<gpu-host>:8000/v1 to develop from a Mac
# against a remote GPU.
VLLM_BASE_URL=http://vllm:8000/v1
VLLM_API_KEY=local-dev-key

# Embeddings service (OpenAI-compatible, CPU).
EMBEDDINGS_BASE_URL=http://embeddings:8001/v1
EMBEDDINGS_MODEL=BAAI/bge-small-en-v1.5
EMBEDDINGS_DIM=384

# --- Generation defaults --------------------------------------------------
MAX_MODEL_LEN=8192
MAX_OUTPUT_TOKENS=1024
TEMPERATURE=0.2
TOP_P=0.9

# --- Retrieval ------------------------------------------------------------
RETRIEVAL_TOP_K=5
# Cosine similarity floor. Below this the assistant escalates instead of
# guessing — see backend/app/services/guardrails.py.
RETRIEVAL_MIN_SCORE=0.35
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64

# --- Database -------------------------------------------------------------
POSTGRES_USER=support
POSTGRES_PASSWORD=support-dev-password
POSTGRES_DB=support
DATABASE_URL=postgresql+asyncpg://support:support-dev-password@postgres:5432/support

# --- Monitoring dashboard --------------------------------------------------
# Leave empty locally. The Monitoring tab then serves a deterministic seeded
# dataset and labels it "Demo data" in the UI, which is what makes the tab
# recordable without a GPU and a load generator running first.
#
# Set it in a real deployment and the same endpoints read live time series:
#   PROMETHEUS_URL=http://kube-prometheus-stack-prometheus.monitoring.svc:9090
PROMETHEUS_URL=

# --- Backend --------------------------------------------------------------
BACKEND_PORT=8080
LOG_LEVEL=INFO
LOG_FORMAT=json
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Frontend -------------------------------------------------------------
# Server-side only. The browser never sees a model endpoint; Next.js route
# handlers proxy every call.
BACKEND_INTERNAL_URL=http://backend:8080
NEXT_PUBLIC_APP_NAME=Support Console

# --- Hugging Face (only needed for the compression pipeline) ---------------
HF_TOKEN=
