# Copy to terraform.tfvars and fill in. Never commit terraform.tfvars.

project_id = "your-gcp-project-id"
region     = "us-central1"

# Restrict Kubernetes API access. Leaving this empty means the API is
# unreachable, which is the safe default — add your operator and CI ranges.
authorized_networks = [
  # { cidr_block = "203.0.113.4/32", display_name = "office" },
]

gpu_zones = ["us-central1-a", "us-central1-c"]
